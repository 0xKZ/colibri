# DeepSeek V4 amalgamation build — x86-64/aarch64 Linux, Windows/MSYS2, and macOS.
# Linux uses GNU ld/gcc; macOS uses clang + libomp (Homebrew); Windows uses MinGW gcc.

ifeq ($(OS),Windows_NT)
IS_WIN := 1
UNAME_S :=
UNAME_M :=
else
IS_WIN :=
UNAME_S := $(shell uname -s 2>/dev/null)
UNAME_M := $(shell uname -m 2>/dev/null)
endif

COLI_V4_OK :=
ifeq ($(IS_WIN),1)
COLI_V4_OK := 1
else ifeq ($(UNAME_S),Linux)
ifneq (,$(filter x86_64 amd64 aarch64 arm64,$(UNAME_M)))
COLI_V4_OK := 1
endif
else ifeq ($(UNAME_S),Darwin)
ifneq (,$(filter x86_64 amd64 aarch64 arm64,$(UNAME_M)))
COLI_V4_OK := 1
endif
endif

ifneq ($(COLI_V4_OK),1)
$(error Makefile.deepseek-v4 supports only x86-64/aarch64 Linux, Windows/MSYS2, and macOS)
endif

ifeq ($(IS_WIN),1)
# --- Windows 11 x86-64 (MinGW-w64 / MSYS2) ---
CC = gcc
CFLAGS = -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64 -O3 -march=$(or $(ARCH),x86-64-v3) -fopenmp \
	-include pthread.h -Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
LDFLAGS = -lm -fopenmp -static -pthread
V4_BINARY := deepseek_v4.exe
else ifeq ($(UNAME_S),Darwin)
# --- macOS / Apple Silicon (and Intel Macs) ---
CC = clang

# Apple clang does not ship OpenMP. Use Homebrew libomp if available,
# otherwise build single-threaded (OpenMP pragmas are silently ignored).
OMPDIR := $(shell brew --prefix libomp 2>/dev/null)
ifneq ($(and $(OMPDIR),$(wildcard $(OMPDIR)/include/omp.h),$(wildcard $(OMPDIR)/lib/libomp.*)),)
OMPC = -Xclang -fopenmp -I$(OMPDIR)/include
OMPL = -L$(OMPDIR)/lib -lomp
else
$(warning libomp not found: building single-threaded. For multithreading: brew install libomp)
OMPC =
OMPL =
endif

# arm64 clang uses -mcpu, not -march. Intel Macs use -march.
# $(or) in recursive (=) vars evaluates at expansion time, properly handling
# empty ARCH from command line (command-line vars override := assignments).
ifeq ($(filter arm64 aarch64,$(UNAME_M)),)
ARCHFLAG = -march=$(or $(ARCH),x86-64-v3)
else
ARCHFLAG = -mcpu=$(or $(ARCH),native)
endif

CFLAGS = -O3 $(ARCHFLAG) $(OMPC) -include pthread.h -Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
LDFLAGS = -lm $(OMPL) -pthread
V4_BINARY := deepseek_v4
else
# --- Linux x86-64 / aarch64 ---
CC = gcc
CFLAGS = -D_GNU_SOURCE -O3 -march=$(or $(ARCH),native) -fopenmp -pthread -include pthread.h \
	-Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
LDFLAGS = -lm -fopenmp -pthread
V4_BINARY := deepseek_v4
endif

LTO ?= 1
ifeq ($(LTO),1)
CFLAGS += -flto
LDFLAGS += -flto
endif

include Makefile.deepseek-v4.units

TARGET_OBJS = $(addsuffix .o,$(V4_TARGET_UNITS))
TEST_UNIT_OBJS = $(addsuffix .o,$(V4_TEST_UNITS))
V4_OBJS = $(TARGET_OBJS)

.PHONY: deepseek-v4 deepseek-v4-clean deepseek-v4-test-objs
deepseek-v4: $(V4_BINARY)

$(V4_BINARY): $(V4_OBJS)
	$(CC) $(V4_OBJS) -o $@ $(LDFLAGS)

$(TARGET_OBJS) $(TEST_UNIT_OBJS): %.o: deepseek_v4.c deepseek_v4.h \
	deepseek_v4_internal.h deepseek_v4_dspark.inc st.h json.h compat.h tensor.h quant.h \
	native_quant.h native_quant_batch.h native_quant_dual.h \
	native_quant_fp4_rows16.h
	$(CC) $(CFLAGS) -D$* -c deepseek_v4.c -o $@

deepseek-v4-test-objs: $(TEST_UNIT_OBJS)

deepseek-v4-clean:
	rm -f $(V4_BINARY) $(V4_OBJS) $(TEST_UNIT_OBJS)
